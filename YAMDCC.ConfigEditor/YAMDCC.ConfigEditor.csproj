<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <ApplicationIcon>fan.ico</ApplicationIcon>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AssemblyName>msi_gf63_tuner</AssemblyName>
        <AssemblyTitle>MSI GF63 Tuner</AssemblyTitle>
        <OutputType>WinExe</OutputType>
        <Title>MSI GF63 Tuner</Title>
        <UseWindowsForms>true</UseWindowsForms>
    </PropertyGroup>
    <ItemGroup>
        <EmbeddedResource Remove="MainForm.resx" />
    </ItemGroup>
    <ItemGroup>
        <None Include="MainForm.resx" />
    </ItemGroup>
    <ItemGroup>
        <Reference Include="System.Management" />
        <Reference Include="System.ServiceProcess" />
    </ItemGroup>
    <ItemGroup>
        <Content Include="fan.ico" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\YAMDCC.Common\YAMDCC.Common.csproj" />
        <ProjectReference Include="..\YAMDCC.ECAccess\YAMDCC.ECAccess.csproj" />
        <ProjectReference Include="..\YAMDCC.IPC\YAMDCC.IPC.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="..\YAMDCC.Service\FanControlService.cs" Link="Service\FanControlService.cs" />
        <Compile Include="..\YAMDCC.Service\SystemControl.cs" Link="Service\SystemControl.cs" />
        <Compile Include="..\YAMDCC.Service\FanControllers\IFanController.cs" Link="Service\FanControllers\IFanController.cs" />
        <Compile Include="..\YAMDCC.Service\FanControllers\Ring0FanController.cs" Link="Service\FanControllers\Ring0FanController.cs" />
        <Compile Include="..\YAMDCC.Service\FanControllers\Wmi2FanController.cs" Link="Service\FanControllers\Wmi2FanController.cs" />
        <Compile Include="..\YAMDCC.Service\Strings.cs" Link="Service\Strings.cs" />
        <EmbeddedResource Include="..\YAMDCC.Service\Strings.resx" Link="Service\Strings.resx">
            <ManifestResourceName>YAMDCC.Service.Strings</ManifestResourceName>
        </EmbeddedResource>
    </ItemGroup>
    <ItemGroup>
      <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.48">
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        <PrivateAssets>all</PrivateAssets>
      </PackageReference>
    </ItemGroup>
</Project>
